{
  "__inputs": [{"name":"DS_XEN_ELASTICSEARCH","label":"XenServer Elasticsearch","type":"datasource","pluginId":"elasticsearch","pluginName":"Elasticsearch"}],
  "uid": "xenserver-pool-overview",
  "title": "XenServer Pool Overview",
  "description": "Recorded pool host and VM metrics. Host and VM counts reflect the selected time range, not live availability. Scheduling is managed separately from Grafana refresh.",
  "tags": ["xenserver", "pool", "elasticsearch"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "editable": true,
  "refresh": "1m",
  "time": {"from":"now-24h","to":"now"},
  "timepicker": {"refresh_intervals":["1m","5m","15m","30m","1h"]},
  "templating": {"list":[
    {"name":"host","label":"Host","type":"query","datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},"query":"{\"find\":\"terms\",\"field\":\"xen.host_name.keyword\",\"query\":\"_exists_:xen.pool_uuid\",\"size\":1000}","refresh":2,"multi":true,"includeAll":true,"allValue":"*","current":{"text":"All","value":"$__all"},"options":[],"sort":1},
    {"name":"metric","label":"Explorer Metric","type":"query","datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},"query":"{\"find\":\"terms\",\"field\":\"xen.metric.keyword\",\"query\":\"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host\",\"size\":5000}","refresh":2,"multi":false,"includeAll":false,"current":{"text":"cpu_avg","value":"cpu_avg"},"options":[],"sort":1}
  ]},
  "panels": [
    {
      "id":1,"type":"stat","title":"Hosts Observed","description":"Distinct hosts with recorded metrics in the selected time range. Not a live health check.","gridPos":{"x":0,"y":0,"w":6,"h":4},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","format":"table","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host","metrics":[{"id":"1","type":"cardinality","field":"xen.host_uuid.keyword"}],"bucketAggs":[{"id":"2","type":"terms","field":"xen.pool_uuid.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}}],"timeField":"@timestamp"}],
      "transformations":[{"id":"filterFieldsByName","options":{"exclude":{"names":["xen.pool_uuid.keyword"]}}}],
      "fieldConfig":{"defaults":{"unit":"short","decimals":0,"color":{"mode":"fixed","fixedColor":"green"}},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"graphMode":"none","colorMode":"value","textMode":"auto"}
    },
    {
      "id":2,"type":"stat","title":"VMs Observed","description":"Distinct VM UUIDs with recorded metrics in the selected time range.","gridPos":{"x":6,"y":0,"w":6,"h":4},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","format":"table","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:vm","metrics":[{"id":"1","type":"cardinality","field":"xen.object_uuid.keyword"}],"bucketAggs":[{"id":"2","type":"terms","field":"xen.pool_uuid.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}}],"timeField":"@timestamp"}],
      "transformations":[{"id":"filterFieldsByName","options":{"exclude":{"names":["xen.pool_uuid.keyword"]}}}],
      "fieldConfig":{"defaults":{"unit":"short","decimals":0,"color":{"mode":"fixed","fixedColor":"blue"}},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"graphMode":"none","colorMode":"value","textMode":"auto"}
    },
    {
      "id":3,"type":"stat","title":"Latest Sample","description":"Age of the newest selected sample. Dashboard refresh does not start or resume the exporter.","gridPos":{"x":12,"y":0,"w":6,"h":4},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","format":"table","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host","metrics":[{"id":"1","type":"max","field":"@timestamp"}],"bucketAggs":[{"id":"2","type":"terms","field":"xen.pool_uuid.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}}],"timeField":"@timestamp"}],
      "transformations":[{"id":"filterFieldsByName","options":{"exclude":{"names":["xen.pool_uuid.keyword"]}}}],
      "fieldConfig":{"defaults":{"unit":"dateTimeFromNow","color":{"mode":"fixed","fixedColor":"orange"}},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"graphMode":"none","colorMode":"value","textMode":"auto"}
    },
    {
      "id":4,"type":"stat","title":"Metric Samples","description":"Number of indexed metric documents within the selected hosts and time range.","gridPos":{"x":18,"y":0,"w":6,"h":4},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","format":"table","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host","metrics":[{"id":"1","type":"count"}],"bucketAggs":[{"id":"2","type":"terms","field":"xen.pool_uuid.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}}],"timeField":"@timestamp"}],
      "transformations":[{"id":"filterFieldsByName","options":{"exclude":{"names":["xen.pool_uuid.keyword"]}}}],
      "fieldConfig":{"defaults":{"unit":"short","decimals":0,"color":{"mode":"fixed","fixedColor":"cyan"}},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"],"values":false},"graphMode":"none","colorMode":"value","textMode":"auto"}
    },
    {
      "id":5,"type":"timeseries","title":"CPU Utilization by Host","gridPos":{"x":0,"y":4,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:cpu_avg","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1,"custom":{"drawStyle":"line","lineWidth":2,"fillOpacity":8,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi","sort":"desc"}}
    },
    {
      "id":6,"type":"timeseries","title":"Host Load Average","gridPos":{"x":12,"y":4,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:loadavg","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"short","min":0,"custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}}
    },
    {
      "id":7,"type":"timeseries","title":"Memory Free / Total","gridPos":{"x":0,"y":12,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}} / {{term xen.metric.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:(memory_free_kib OR memory_total_kib)","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"4","type":"terms","field":"xen.metric.keyword","settings":{"size":"2","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"kbytes","min":0,"custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}}
    },
    {
      "id":8,"type":"timeseries","title":"Running Domains by Host","description":"XenServer running_domains metric, which may include the control domain.","gridPos":{"x":12,"y":12,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:running_domains","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"short","decimals":0,"min":0,"custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}}
    },
    {
      "id":9,"type":"timeseries","title":"Network Receive","gridPos":{"x":0,"y":20,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:pif_aggr_rx","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"Bps","min":0,"custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}}
    },
    {
      "id":10,"type":"timeseries","title":"Network Transmit","gridPos":{"x":12,"y":20,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:pif_aggr_tx","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"Bps","min":0,"custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}}
    },
    {
      "id":11,"type":"timeseries","title":"Storage IOPS by Host / Device","gridPos":{"x":0,"y":28,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}} / {{term xen.metric.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:iops_total_*","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"4","type":"terms","field":"xen.metric.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"iops","min":0,"custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}}
    },
    {
      "id":12,"type":"timeseries","title":"Storage Throughput by Host / Device","gridPos":{"x":12,"y":28,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}} / {{term xen.metric.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:io_throughput_total_*","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"4","type":"terms","field":"xen.metric.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"Bps","min":0,"custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}}
    },
    {
      "id":13,"type":"timeseries","title":"Host Power Consumption","gridPos":{"x":0,"y":36,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.object_type.keyword:host AND xen.metric.keyword:DCMI-power-reading","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"watt","min":0,"custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}}
    },
    {
      "id":14,"type":"timeseries","title":"Metric Explorer: $metric","description":"Raw values for the selected recorded host or VM metric. Series are separated by host and object UUID; units depend on the selected metric.","gridPos":{"x":12,"y":36,"w":12,"h":8},"datasource":{"type":"elasticsearch","uid":"${DS_XEN_ELASTICSEARCH}"},
      "targets":[{"refId":"A","alias":"{{term xen.host_name.keyword}} / {{term xen.object_uuid.keyword}}","query":"_exists_:xen.pool_uuid AND xen.host_name.keyword:$host AND xen.metric.keyword:$metric","metrics":[{"id":"1","type":"avg","field":"value"}],"bucketAggs":[{"id":"3","type":"terms","field":"xen.host_name.keyword","settings":{"size":"100","order":"asc","orderBy":"_key"}},{"id":"4","type":"terms","field":"xen.object_uuid.keyword","settings":{"size":"1000","order":"asc","orderBy":"_key"}},{"id":"2","type":"date_histogram","field":"@timestamp","settings":{"interval":"1m","min_doc_count":"0"}}],"timeField":"@timestamp"}],
      "fieldConfig":{"defaults":{"unit":"short","custom":{"lineWidth":2,"showPoints":"always","pointSize":4,"spanNulls":false}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}}
    }
  ]
}